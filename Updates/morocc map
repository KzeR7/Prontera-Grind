<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ragnarok Online 2.5D Sprite Map — Morocc Desert Ruins (Single-File Engine)</title>
  <style>
    :root {
      --bg: #110f0c;
      --panel: rgba(24, 20, 15, 0.94);
      --border: rgba(196, 158, 98, 0.32);
      --accent: #f0b849;
      --accent-green: #48e59a;
      --text: #f5ede0;
      --muted: #b09f84;
      --danger: #ff6464;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      height: 100vh;
      width: 100vw;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .topbar {
      height: 50px;
      background: linear-gradient(180deg, #241d15 0%, #17120d 100%);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 14px;
      gap: 10px;
      z-index: 20;
    }
    .brand { display: flex; align-items: center; gap: 10px; }
    .badge {
      background: linear-gradient(135deg, #c2862b, #805315);
      border: 1px solid #f5cb6c;
      color: #fff;
      font-weight: 700;
      font-size: 11px;
      padding: 3px 8px;
      border-radius: 4px;
    }
    .brand-title { font-size: 14px; font-weight: 700; color: #fff; }
    .brand-sub { font-size: 11px; color: var(--muted); }
    .tabs {
      display: flex;
      background: rgba(10, 8, 6, 0.75);
      padding: 3px;
      border-radius: 6px;
      border: 1px solid rgba(255,255,255,0.08);
      gap: 4px;
    }
    .tab {
      background: transparent;
      color: var(--muted);
      border: none;
      padding: 5px 12px;
      font-size: 12px;
      font-weight: 600;
      border-radius: 4px;
      cursor: pointer;
    }
    .tab.active {
      background: linear-gradient(135deg, #b87b22, #8a5612);
      color: #fff;
    }
    .actions { display: flex; align-items: center; gap: 7px; }
    .btn {
      background: rgba(54, 43, 30, 0.88);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 6px 11px;
      font-size: 12px;
      font-weight: 600;
      border-radius: 5px;
      cursor: pointer;
    }
    .btn:hover { border-color: var(--accent); background: rgba(76, 60, 42, 0.95); }
    .btn-primary {
      background: linear-gradient(135deg, #208c5c, #14613e);
      border-color: var(--accent-green);
      color: #fff;
    }
    .workspace { flex: 1; display: flex; overflow: hidden; position: relative; }
    .viewport { flex: 1; position: relative; background: #72c2e8; overflow: hidden; }
    #mapCanvas { width: 100%; height: 100%; display: block; cursor: crosshair; }
    .hud {
      position: absolute;
      top: 12px;
      left: 12px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 7px;
      padding: 8px 12px;
      font-size: 12px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      pointer-events: none;
    }
    .hud-row { display: flex; gap: 12px; }
    .stat { color: var(--accent); font-weight: 700; font-family: monospace; }
    .hint {
      position: absolute;
      bottom: 12px;
      left: 12px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 7px;
      padding: 6px 12px;
      font-size: 11px;
      color: var(--muted);
      display: flex;
      gap: 14px;
      pointer-events: none;
    }
    .hint b { color: var(--accent); }
    .sidebar {
      width: 300px;
      background: var(--panel);
      border-left: 1px solid var(--border);
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      overflow-y: auto;
      z-index: 15;
    }
    .card {
      background: rgba(12, 10, 7, 0.65);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 7px;
      padding: 10px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .card-title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: var(--accent);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
      gap: 8px;
    }
    .row label { color: var(--muted); }
    .row input[type="range"] { flex: 1; accent-color: var(--accent); }
    select {
      background: #1a1510;
      color: #fff;
      border: 1px solid var(--border);
      padding: 4px 7px;
      border-radius: 4px;
      font-size: 12px;
    }
    .grid-palette {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 5px;
    }
    .p-item {
      background: rgba(42, 34, 24, 0.7);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 4px;
      padding: 6px 8px;
      font-size: 11px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .p-item.active {
      background: rgba(240, 184, 73, 0.25);
      border-color: var(--accent);
      color: #fff;
      font-weight: 600;
    }
    .swatch { width: 12px; height: 12px; border-radius: 2px; border: 1px solid rgba(255,255,255,0.3); }
    .modal-bg {
      position: fixed;
      inset: 0;
      background: rgba(8, 6, 4, 0.85);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 20px;
    }
    .modal-bg.open { display: flex; }
    .modal {
      background: #1c1610;
      border: 1px solid var(--border);
      border-radius: 8px;
      width: 100%;
      max-width: 880px;
      max-height: 86vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .modal-head {
      padding: 11px 15px;
      background: #261e15;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .modal-body {
      padding: 14px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    textarea.code {
      width: 100%;
      min-height: 260px;
      background: #0d0a07;
      color: #f5cb6c;
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 5px;
      padding: 10px;
      font-family: monospace;
      font-size: 12px;
      user-select: text;
    }
    .atlas-box {
      background: repeating-conic-gradient(#221c15 0% 25%, #16120d 0% 50%) 50% / 20px 20px;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 8px;
      text-align: center;
      overflow: auto;
    }
    .atlas-box canvas { max-width: 100%; height: auto; }
  </style>
</head>
<body>

  <header class="topbar">
    <div class="brand">
      <span class="badge">SINGLE-FILE RO 2.5D</span>
      <div>
        <div class="brand-title">moc_fild — Morocc Desert Ruins & Palm Oasis</div>
        <div class="brand-sub">All-in-One Procedural Sprite Sheet + 3D .GND Heightmap + .GAT Pathfinding</div>
      </div>
    </div>

    <div class="tabs">
      <button class="tab active" data-mode="play">Play / Walk (A*)</button>
      <button class="tab" data-mode="terrain">Terrain & Height Brush</button>
      <button class="tab" data-mode="sprites">Sprite Placer</button>
    </div>

    <div class="actions">
      <button class="btn" id="btnShowAtlas">Sprite Sheet</button>
      <button class="btn" id="btnShowJson">Map JSON</button>
      <button class="btn btn-primary" id="btnCopyPasteCode">Copy Minimal Game Code</button>
    </div>
  </header>

  <div class="workspace">
    <div class="viewport" id="viewport">
      <canvas id="mapCanvas" width="1100" height="700"></canvas>

      <div class="hud">
        <div class="hud-row">
          <span>FPS: <span class="stat" id="hudFps">60</span></span>
          <span>Cell: <span class="stat" id="hudCell">20, 22</span></span>
          <span>Height: <span class="stat" id="hudH">1.40</span></span>
        </div>
        <div class="hud-row">
          <span>Tile: <span class="stat" id="hudTile">sand</span></span>
          <span>Walkable: <span class="stat" id="hudWalk">YES</span></span>
          <span>Sprites: <span class="stat" id="hudSprites">34</span></span>
        </div>
      </div>

      <div class="hint">
        <span><b>Left-Click:</b> Walk / Paint / Place</span>
        <span><b>Right-Drag:</b> Orbit 3D Camera</span>
        <span><b>Wheel:</b> Zoom</span>
        <span><b>WASD:</b> Pan</span>
        <span><b>[G]:</b> Walk Grid</span>
        <span><b>[R]:</b> Reset Angle</span>
      </div>
    </div>

    <aside class="sidebar">
      <div class="card">
        <div class="card-title"><span>View & Layers</span></div>
        <div class="row">
          <label>Render Mode</label>
          <select id="selRenderMode">
            <option value="ro_25d">2.5D Sprite Map Engine</option>
            <option value="split_ref">Split Compare vs Reference</option>
          </select>
        </div>
        <div class="row" id="rowSplit" style="display:none;">
          <label>Split Slider</label>
          <input type="range" id="rngSplit" min="0.05" max="0.95" step="0.01" value="0.50" />
        </div>
        <label class="row" style="cursor:pointer;">
          <span>Show .GAT Walkable Grid (G)</span>
          <input type="checkbox" id="chkGrid" />
        </label>
        <label class="row" style="cursor:pointer;">
          <span>Palm Canopy X-Ray Alpha</span>
          <input type="checkbox" id="chkXray" checked />
        </label>
        <label class="row" style="cursor:pointer;">
          <span>Desert Wind Sway</span>
          <input type="checkbox" id="chkWind" checked />
        </label>
      </div>

      <div class="card">
        <div class="card-title">
          <span>3D Camera Angle</span>
          <button class="btn" id="btnResetCam" style="padding:2px 7px;font-size:10px;">Reset (R)</button>
        </div>
        <div class="row">
          <label>Orbit Yaw</label>
          <input type="range" id="rngYaw" min="-1.5" max="1.5" step="0.01" value="0.00" />
        </div>
        <div class="row">
          <label>Tilt Pitch</label>
          <input type="range" id="rngPitch" min="0.42" max="1.10" step="0.01" value="0.68" />
        </div>
        <div class="row">
          <label>Zoom</label>
          <input type="range" id="rngZoom" min="0.65" max="2.10" step="0.02" value="1.00" />
        </div>
      </div>

      <!-- Play Mode Panel -->
      <div class="card" id="panelPlay">
        <div class="card-title"><span>Quick Navigation</span></div>
        <p style="font-size:11px;color:var(--muted);line-height:1.45;">
          Click any desert sand or ancient cobblestone cell to walk the RO Adventurer around the ruins, cacti, and giant palm trees.
        </p>
        <div style="display:flex;gap:6px;flex-wrap:wrap;">
          <button class="btn" id="btnWalkRuins" style="flex:1;">Walk to Cobble Ruins</button>
          <button class="btn" id="btnWalkPalm" style="flex:1;">Walk to Giant Palm</button>
        </div>
      </div>

      <!-- Terrain Brush Panel -->
      <div class="card" id="panelTerrain" style="display:none;">
        <div class="card-title"><span>Desert Terrain Brush</span></div>
        <div class="row">
          <label>Brush Size</label>
          <input type="range" id="rngBrush" min="1" max="4" step="1" value="1" />
        </div>
        <div class="grid-palette" id="terrainPalette">
          <div class="p-item active" data-brush="sand"><span class="swatch" style="background:#94764c;"></span>Desert Sand</div>
          <div class="p-item" data-brush="sand_dark"><span class="swatch" style="background:#6e5636;"></span>Dark Earth</div>
          <div class="p-item" data-brush="ruin_cobble"><span class="swatch" style="background:#746c60;"></span>Cobble Ruins</div>
          <div class="p-item" data-brush="cliff"><span class="swatch" style="background:#4f4132;"></span>Desert Cliff</div>
          <div class="p-item" data-brush="sky"><span class="swatch" style="background:#72c2e8;"></span>Horizon Sky</div>
          <div class="p-item" data-brush="raise"><span class="swatch" style="background:#48e59a;"></span>Raise Dune +</div>
          <div class="p-item" data-brush="lower"><span class="swatch" style="background:#ff6464;"></span>Lower Dune -</div>
          <div class="p-item" data-brush="walk_toggle"><span class="swatch" style="background:#f0b849;"></span>Toggle Walk</div>
        </div>
      </div>

      <!-- Sprite Placer Panel -->
      <div class="card" id="panelSprites" style="display:none;">
        <div class="card-title"><span>Morocc Sprite Placer</span></div>
        <div class="grid-palette" id="spritePalette">
          <div class="p-item active" data-sprite="palm_giant">Giant Foreground Palm</div>
          <div class="p-item" data-sprite="palm_tall">Tall Desert Palm</div>
          <div class="p-item" data-sprite="palm_double">Twin-Trunk Palm</div>
          <div class="p-item" data-sprite="cactus_flower">Flowering Cactus</div>
          <div class="p-item" data-sprite="cactus_small">Small Cactus</div>
          <div class="p-item" data-sprite="ruin_pillar">Stone Shrine Pillar</div>
          <div class="p-item" data-sprite="ruin_column_fallen">Fallen Column</div>
          <div class="p-item" data-sprite="ruin_stump">Column Stump</div>
          <div class="p-item" data-sprite="ruin_curb">Stone Border Curb</div>
          <div class="p-item" data-sprite="desert_bone">Desert Bone Fossil</div>
        </div>
        <div class="row">
          <label>Scale</label>
          <input type="range" id="rngSpScale" min="0.55" max="1.65" step="0.05" value="1.00" />
        </div>
        <label class="row" style="cursor:pointer;">
          <span>Flip Horizontal</span>
          <input type="checkbox" id="chkSpFlip" />
        </label>
        <button class="btn" id="btnDelSprite" style="border-color:var(--danger);color:#ff9c9c;">Delete Last / Selected Sprite</button>
      </div>

      <div class="card">
        <div class="card-title"><span>Download Assets</span></div>
        <div style="display:flex;gap:6px;">
          <button class="btn" id="btnDlMapPng" style="flex:1;">Map (.PNG)</button>
          <button class="btn" id="btnDlSheetPng" style="flex:1;">Sprites (.PNG)</button>
        </div>
      </div>
    </aside>
  </div>

  <!-- Modal: Procedural Sprite Sheet Preview -->
  <div class="modal-bg" id="modalAtlas">
    <div class="modal">
      <div class="modal-head">
        <strong>Procedural Morocc Desert Sprite Sheet Atlas (Generated in Pure JS — Zero External Images Needed)</strong>
        <div style="display:flex;gap:8px;">
          <button class="btn btn-primary" id="btnModalDlSheet">Download Sprite Sheet (.PNG)</button>
          <button class="btn" data-close="modalAtlas">Close</button>
        </div>
      </div>
      <div class="modal-body">
        <div class="atlas-box" id="atlasContainer"></div>
      </div>
    </div>
  </div>

  <!-- Modal: Map Data JSON -->
  <div class="modal-bg" id="modalJson">
    <div class="modal">
      <div class="modal-head">
        <strong>Map Data JSON (Heightmap + Walkability + Sprites)</strong>
        <div style="display:flex;gap:8px;">
          <button class="btn btn-primary" id="btnCopyJson">Copy JSON</button>
          <button class="btn" id="btnApplyJson">Apply JSON</button>
          <button class="btn" data-close="modalJson">Close</button>
        </div>
      </div>
      <div class="modal-body">
        <textarea class="code" id="txtJson" spellcheck="false"></textarea>
      </div>
    </div>
  </div>

  <!-- Modal: Minimal Copy-Paste Code -->
  <div class="modal-bg" id="modalCode">
    <div class="modal">
      <div class="modal-head">
        <strong>All-in-One Copy-Paste Snippet for Your HTML Game</strong>
        <div style="display:flex;gap:8px;">
          <button class="btn btn-primary" id="btnCopySnippet">Copy Snippet</button>
          <button class="btn" data-close="modalCode">Close</button>
        </div>
      </div>
      <div class="modal-body">
        <p style="font-size:12px;color:var(--muted);">
          Everything in this project is combined into <b>this single <code>index.html</code> file</b> with zero external image or JSON files required. You can either copy <code>index.html</code> directly, or paste the minimal initialization snippet below:
        </p>
        <textarea class="code" id="txtSnippet" readonly></textarea>
      </div>
    </div>
  </div>

  <script>
  // ============================================================================
  // 1. PROCEDURAL RAGNAROK ONLINE MOROCC DESERT SPRITE SHEET & TILE GENERATOR
  //    Generates all seamless tiles & 2.5D sprites on a single canvas in memory.
  // ============================================================================
  function createMoroccSpriteAtlas() {
    const W = 1280, H = 620;
    const canvas = document.createElement('canvas');
    canvas.width = W;
    canvas.height = H;
    const ctx = canvas.getContext('2d');

    const manifest = {
      tiles: {},
      sprites: {},
      character: { x: 1000, y: 490, frameW: 64, frameH: 80, frames: 4 }
    };

    // Deterministic PRNG for consistent procedural textures
    let seed = 1337;
    const rand = () => {
      seed = (seed * 16807) % 2147483647;
      return (seed - 1) / 2147483646;
    };

    // Helper: generate 128x128 seamless desert & ruin tiles
    function makeTile(tx, ty, name, painterFn) {
      const tc = document.createElement('canvas');
      tc.width = 128;
      tc.height = 128;
      painterFn(tc.getContext('2d'), 128, 128);
      ctx.drawImage(tc, tx, ty);
      manifest.tiles[name] = { x: tx, y: ty, w: 128, h: 128, canvas: tc };
    }

    // Tile 1: Main Morocc Golden-Tan Desert Sand (with subtle RO grid border)
    makeTile(16, 16, 'sand', (c, w, h) => {
      c.fillStyle = '#92754b';
      c.fillRect(0, 0, w, h);
      for (let i = 0; i < 950; i++) {
        const x = rand() * w, y = rand() * h;
        const r = 2 + rand() * 8;
        c.fillStyle = rand() > 0.5 ? 'rgba(168, 138, 92, 0.16)' : 'rgba(112, 86, 52, 0.16)';
        c.beginPath();
        c.ellipse(x, y, r * 1.6, r * 0.7, 0.2, 0, Math.PI * 2);
        c.fill();
      }
      // Subtle wind ripple lines
      c.strokeStyle = 'rgba(182, 150, 102, 0.15)';
      c.lineWidth = 1.5;
      for (let y = 8; y < h; y += 16) {
        c.beginPath();
        c.moveTo(0, y);
        c.bezierCurveTo(42, y - 4, 84, y + 4, w, y);
        c.stroke();
      }
    });

    // Tile 2: Disturbed Dark Desert Earth (halo around cobblestone ruins & palm shadows)
    makeTile(160, 16, 'sand_dark', (c, w, h) => {
      c.fillStyle = '#6c5434';
      c.fillRect(0, 0, w, h);
      for (let i = 0; i < 800; i++) {
        const x = rand() * w, y = rand() * h;
        const r = 2 + rand() * 7;
        c.fillStyle = rand() > 0.45 ? 'rgba(84, 64, 38, 0.24)' : 'rgba(130, 102, 64, 0.18)';
        c.beginPath();
        c.arc(x, y, r, 0, Math.PI * 2);
        c.fill();
      }
    });

    // Tile 3: Ancient Stone Cobblestone Ruin Floor (grey-brown masonry blocks)
    makeTile(304, 16, 'ruin_cobble', (c, w, h) => {
      c.fillStyle = '#5c5244';
      c.fillRect(0, 0, w, h);
      const rows = 8, cols = 6;
      const bh = h / rows, bw = w / cols;
      for (let r = 0; r < rows; r++) {
        const offset = (r % 2) * (bw * 0.5);
        for (let col = -1; col <= cols; col++) {
          const bx = col * bw + offset + 1.5;
          const by = r * bh + 1.5;
          const shade = 104 + Math.floor((rand() - 0.5) * 26);
          c.fillStyle = `rgb(${shade + 6}, ${shade}, ${shade - 8})`;
          c.fillRect(bx, by, bw - 3, bh - 3);
          c.strokeStyle = 'rgba(210, 198, 178, 0.25)';
          c.strokeRect(bx + 0.5, by + 0.5, bw - 4, bh - 4);
        }
      }
    });

    // Tile 4: Dark Stratified Desert Cliff Rock (matching left/right crags & northern ridge)
    makeTile(448, 16, 'cliff', (c, w, h) => {
      c.fillStyle = '#473a2b';
      c.fillRect(0, 0, w, h);
      for (let i = 0; i < 420; i++) {
        const x = rand() * w, y = rand() * h;
        c.fillStyle = rand() > 0.5 ? 'rgba(118, 102, 82, 0.24)' : 'rgba(32, 24, 16, 0.32)';
        c.beginPath();
        c.moveTo(x, y);
        c.lineTo(x + 14, y - 8);
        c.lineTo(x + 8, y + 16);
        c.closePath();
        c.fill();
      }
      // Diagonal rock strata crevices
      c.strokeStyle = 'rgba(22, 16, 10, 0.55)';
      c.lineWidth = 2;
      for (let k = -w; k < w * 2; k += 22) {
        c.beginPath();
        c.moveTo(k, 0);
        c.lineTo(k - 36, h);
        c.stroke();
      }
    });

    // Helper: paint a drooping feathery desert palm frond from (x0, y0) at angle & length
    function drawPalmFrond(c, x0, y0, angle, length, curveDown, tintShift = 0) {
      const steps = 26;
      const pts = [];
      for (let i = 0; i <= steps; i++) {
        const t = i / steps;
        const px = x0 + Math.cos(angle) * length * t;
        const py = y0 + Math.sin(angle) * length * t + (t * t) * curveDown;
        pts.push({ x: px, y: py, t });
      }
      // Central rachis stem
      c.save();
      c.strokeStyle = '#7c6e2e';
      c.lineWidth = 2.4;
      c.beginPath();
      c.moveTo(pts[0].x, pts[0].y);
      for (const p of pts) c.lineTo(p.x, p.y);
      c.stroke();

      // Individual pointed leaflets along both sides of the frond
      for (let i = 2; i < steps; i++) {
        const p = pts[i];
        const env = Math.sin(p.t * Math.PI);
        const leafLen = (10 + env * 18);
        for (const side of [-1, 1]) {
          const lAngle = angle + side * 0.85 + p.t * 0.35 * side;
          const lx = p.x + Math.cos(lAngle) * leafLen;
          const ly = p.y + Math.sin(lAngle) * leafLen + 5;
          const g = Math.min(255, Math.max(40, Math.floor(118 + env * 34 + side * 14 + tintShift)));
          const r = Math.floor(g * 0.78);
          const b = Math.floor(g * 0.28);
          c.fillStyle = `rgba(${r}, ${g}, ${b}, 0.94)`;
          c.beginPath();
          c.moveTo(p.x, p.y);
          c.lineTo((p.x + lx) * 0.5 - 2, (p.y + ly) * 0.5 - 2);
          c.lineTo(lx, ly);
          c.lineTo((p.x + lx) * 0.5 + 2, (p.y + ly) * 0.5 + 2);
          c.closePath();
          c.fill();
        }
      }
      c.restore();
    }

    // Helper: paint diamond-scaled palm trunk along a quadratic curve
    function drawScalyPalmTrunk(c, x0, y0, cx, cy, x1, y1, baseW, topW, detailedScales = true) {
      const steps = detailedScales ? 28 : 18;
      for (let i = 0; i < steps; i++) {
        const t = i / steps;
        const inv = 1 - t;
        const px = inv * inv * x0 + 2 * inv * t * cx + t * t * x1;
        const py = inv * inv * y0 + 2 * inv * t * cy + t * t * y1;
        const rw = baseW * (1 - t) + topW * t;
        const rh = (Math.hypot(x1 - x0, y1 - y0) / steps) * 0.82;

        // Base ring segment
        c.fillStyle = '#5c4628';
        c.beginPath();
        c.ellipse(px, py, rw, rh, 0.15, 0, Math.PI * 2);
        c.fill();

        if (detailedScales) {
          // Diamond overlapping palm bark scales (matching foreground palm in image-1.png)
          const cols = 4;
          for (let col = -cols; col <= cols; col++) {
            const frac = (col + (i % 2) * 0.5) / (cols + 0.8);
            if (Math.abs(frac) > 0.92) continue;
            const sx = px + frac * rw * 0.92;
            const sy = py + (1 - Math.abs(frac)) * 2;
            const sw = (rw / cols) * 0.88;
            const sh = rh * 0.92;

            c.fillStyle = frac < 0.15 ? '#cbb07c' : '#9c8050';
            c.strokeStyle = '#3d2d18';
            c.lineWidth = 1.1;
            c.beginPath();
            c.moveTo(sx, sy - sh);
            c.lineTo(sx + sw, sy);
            c.lineTo(sx, sy + sh);
            c.lineTo(sx - sw, sy);
            c.closePath();
            c.fill();
            c.stroke();
          }
        } else {
          c.fillStyle = '#a88c5c';
          c.beginPath();
          c.ellipse(px - rw * 0.15, py, rw * 0.78, rh * 0.72, 0.15, 0, Math.PI * 2);
          c.fill();
        }
      }
    }

