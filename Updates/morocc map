      const rad = Math.max(0, (engine.options.brushSize || 1) - 1);
      for (let dy = -rad; dy <= rad; dy++) {
        for (let dx = -rad; dx <= rad; dx++) {
          const c = engine.getCell(center.x + dx, center.y + dy);
          if (!c) continue;
          if (brush === 'raise') c.h = c.h.map(v => +(v + 0.25).toFixed(2));
          else if (brush === 'lower') c.h = c.h.map(v => +(v - 0.25).toFixed(2));
