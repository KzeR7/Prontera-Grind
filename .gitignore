__pycache__/
*.pyc
.venv/
dist/

tools/.devdb/
# tools/tests/town_smoke.js installs these with --no-save; the game itself has no build step
# The bare pattern also covers a node_modules SYMLINK: `node_modules/` only matches a real
# directory, so a symlink (the floor-render harness uses one) used to slip through and get
# committed as a machine-specific absolute path.
node_modules
node_modules/

# Local endgame scenery browser captures and reports
tools/preview/endgame-captures/

# terrain-v2 review renders: regenerate with tools/maps/terrain-v2/render_floor.py +
# render_floor_real.js. The summary boards are committed, the per-field 2048² floors are not.
docs/proposals/terrain-v2/floor-*.png

# local screenshot harnesses (playwright, throwaway)
.tmpcheck/

# Browser acceptance captures: the driver always writes full-size PNGs, and every run overwrites
# them, so they must never dirty the working tree — tools/staging/update-and-stage.ps1 refuses to
# run unless `git status --porcelain` is empty. The reviewed, compressed copies that the docs and
# reports/browser-acceptance/README.md link to are committed as *.jpg in the same folder.
reports/browser-acceptance/*.png

# local source cache for tools/make_expanded_pack.py
.cache/
